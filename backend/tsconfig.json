{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false
  },
  "include": ["../backend/**/*", "../database/**/*.ts", "../security/**/*.ts"],
  "exclude": ["../dist", "../node_modules"]
}
